{
  "openapi": "3.1.0",
  "info": {
    "title": "Inside Inference local execution",
    "version": "1.0.0"
  },
  "paths": {
    "/api/capabilities": {
      "get": {
        "operationId": "capabilities",
        "responses": {
          "200": {
            "description": "Capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./inference.schema.json#/$defs/Capabilities"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "post": {
        "operationId": "run",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./inference.schema.json#/$defs/Workload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RunRecord",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./inference.schema.json#/$defs/RunRecord"
                }
              }
            }
          },
          "400": {
            "description": "ApiError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./inference.schema.json#/$defs/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "ApiError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./inference.schema.json#/$defs/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cache-runs": {
      "post": {
        "operationId": "cacheRun",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./inference.schema.json#/$defs/CacheExperiment"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CacheRun",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./inference.schema.json#/$defs/CacheRun"
                }
              }
            }
          },
          "400": {
            "description": "ApiError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./inference.schema.json#/$defs/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "ApiError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./inference.schema.json#/$defs/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cache-capabilities": {
      "get": {
        "operationId": "cacheCapabilities",
        "responses": {
          "200": {
            "description": "Capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./inference.schema.json#/$defs/CacheCapabilities"
                }
              }
            }
          }
        }
      }
    }
  },
  "x-unknown-route-response": {
    "status": 404,
    "schema": {
      "$ref": "./inference.schema.json#/$defs/ApiError"
    }
  }
}
